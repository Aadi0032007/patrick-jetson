# Orin NX 16 GB migration baseline; copy to .env.jetson and add your own key.
# Load with --env-file .env.jetson. This does not change the Windows .env.
DEFAULT_PROVIDER=hybrid
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
LOCAL_MODEL=qwen3.5:2b-q8_0
LOCAL_API=ollama
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_TEMPERATURE=0.4
LOCAL_TOP_P=0.95
LOCAL_PRESENCE_PENALTY=0
LOCAL_NUM_PREDICT=384
# Start at 8k on shared RAM. Increase only after measuring peak memory/latency.
LOCAL_CONTEXT_LENGTH=8192
LOCAL_KEEP_ALIVE=30m
LOCAL_TIMEOUT_SECONDS=120
PROVIDER_TIMEOUT_SECONDS=20
HYBRID_ROUTER_TIMEOUT_SECONDS=10
HYBRID_OFFLINE_RETRY_SECONDS=30
SESSION_MEMORY_EXCHANGES=3
RAG_KNOWLEDGE_FILE=knowledge/revobots.json
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=openai
WEB_SEARCH_MODEL=gpt-6-luna
SEARCH_TIMEOUT_SECONDS=30
SEARCH_ACK_TEXT="Ummm, let me check."
STT_ENGINE=qwen
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-0.6B
QWEN_ASR_DEVICE=cuda:0
QWEN_ASR_DTYPE=float16
QWEN_ASR_LANGUAGE=auto
TTS_ENGINE=chatterbox
CHATTERBOX_DEVICE=cuda
CHATTERBOX_CPU_THREADS=4
CHATTERBOX_WARMUP=true
CHATTERBOX_LANGUAGE=auto
CHATTERBOX_REFERENCE_AUDIO=
# Default worker paths use .qwen-asr-env/bin/python and .chatterbox-env/bin/python.
# Set QWEN_ASR_PYTHON/CHATTERBOX_PYTHON only for different Linux environment locations.
